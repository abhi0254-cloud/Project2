<% layout("/layouts/boilerplate") %>
<body>
    
    <div class="row mt-2">
        <div class="col-8 offset-2">
            <br/>
    <h3>Create a New Listing</h3>
    <form method="POST" 
       action="/listings" 
       novalidate class="needs-validation"
       enctype="multipart/form-data"  
    >
        <div class="mb-3">
         <label for="title"  placeholde="Enter title" type="text" class="form-label">Title</label> 
        <input name="listing[title]" placeholder="Add a catchy title" type="text" required class="form-control"/>
        <div class="valid-feedback">Title looks good</div>
        </div>
        <div class="mb-3">   
         <label for="description"  placeholde="Enter description" type="text" class="form-label">description</label>
        <input name="listing[description]" placeholder="enter description"  class="form-control"/>
         <!-- <div class="invalid-feedback">Pease enter a short description</div>
        </div> -->
        <!-- <div class="mb-3">
             <label for="Image"  placeholde="Enter Image/link" type="text" class="form-label">
                Image-Link/URL
             </label>
         <input name="listing[image][url]" placeholder="enter image url" type="text" class="form-control">
        </div> -->
         <div class="mb-3">
             <label for="Image" class="form-label">
                Upload image/files
             </label>
             <input name="listing[image]"  type="file" class="form-control">
             required
         </div>

        <div class="row">
            <div class="mb-3 col-3">
             <label for="price"  placeholde="Enter Price" type="text"   class="form-label">Price</label>
             <input name="listing[price]" placeholder="1200" required type="" class="form-control"/>
             <div class="invalid-feedback">Please enter a valid Price</div>
            </div>
              <div class="mb-3 col-8">
             <label form="country"  placeholde="Enter country" type="text" class="form-label">country</label>
            
        <input name="listing[country]" placeholder="enter country" type="text" required class="form-control"/>
         <div class="invalid-feedback">country name should be valid</div>
        </div>
        </div>
        
        <div class="mb-3">
             <label for="location"  placeholde="Enter location" type="text" class="form-label">location</label>
    
        <input name="listing[location]" placeholder="enter location" required type="text" class="form-control"/>
         <div class="invalid-feedback">Location should be valid</div>
        </div>
       
        <button class="add-btn btn-dark mb-3">Add</button>
    </form>
    </div>
    </div>
</body>
